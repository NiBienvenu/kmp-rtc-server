# =============================================================================
# kmp-rtc-server: variables d'environnement
# Copier en .env puis adapter. Ne jamais publier .env (il peut contenir des secrets).
# Les secrets vides sont generes automatiquement au premier demarrage et gardes
# dans le volume kmp-data (/var/lib/kmp-rtc/secrets).
# Chaque secret peut aussi venir d'un fichier: DB_PASSWORD_FILE=/run/secrets/db_password
# =============================================================================

# --- Image (docker compose) ---------------------------------------------------
# ghcr.io/nibienvenu/kmp-rtc-server (GitHub) ou nibienvenu/kmp-rtc-server (Docker Hub)
KMP_RTC_IMAGE=ghcr.io/nibienvenu/kmp-rtc-server
KMP_RTC_TAG=latest
KMP_MEMORY_LIMIT=2g
TZ=UTC

# --- Identite publique --------------------------------------------------------
# Nom DNS du serveur (certificat TLS, URL de l'API). "localhost" pour un test local.
PUBLIC_HOSTNAME=rtc.example.com
# IP que les clients utilisent pour joindre le serveur (IP publique du VPS,
# ou IP LAN de la machine pour un test en reseau local).
# Obligatoire en mode bridge Docker, sinon pas d'audio (le NAT Docker cache l'IP).
EXTERNAL_IP=
# Reseaux "internes" pour Asterisk (local_net). Vide = reseau du conteneur (detecte).
LOCAL_NETS=
# Domaine SIP donne aux applis. Vide = PUBLIC_HOSTNAME (ou EXTERNAL_IP si localhost).
SIP_DOMAIN=

# --- HTTP / TLS (Nginx) -------------------------------------------------------
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
# true en production (une fois le vrai certificat installe dans config/certs)
HTTP_REDIRECT_HTTPS=false
CORS_ALLOWED_HOSTS=*
NGINX_AUTH_RATE=10r/m
NGINX_API_RATE=30r/s

# --- SIP / RTP (Asterisk) -----------------------------------------------------
SIP_PORT=5060
# udp | tcp | tls (transport annonce aux applis)
SIP_TRANSPORT=udp
SIP_TLS_ENABLED=false
SIP_TLS_PORT=5061
# Plage RTP: identique dans Docker, dans le pare-feu et dans rtp.conf (automatique)
RTP_START=10000
RTP_END=10099
# Plage elastique (network_mode: host seulement, voir docker-compose.host.yml):
# +RTP_STEP ports quand RTP_SCALE_UP_PCT % sont occupes, jusqu'a RTP_MAX_END
RTP_AUTOSCALE=false
RTP_STEP=100
RTP_MAX_END=20000
RTP_SCALE_UP_PCT=80
RTP_SCALE_DOWN_PCT=30
RTP_CHECK_INTERVAL=5
# sdes (SRTP si le client le propose) | no
MEDIA_ENCRYPTION=sdes
CODECS_AUDIO=opus,g722,ulaw,alaw
CODECS_VIDEO=h264,vp8
# Conferences: follow_talker (SIP natif) | sfu (WebRTC)
CONF_VIDEO_MODE=follow_talker
CONF_MAX_MEMBERS=50
ASTERISK_VERBOSE=3

# --- STUN / TURN (coturn) -----------------------------------------------------
TURN_ENABLED=true
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Secret partage Ktor <-> coturn (vide = genere)
TURN_SECRET=
# STUN donne aux applis ("host:port"). Vide = coturn integre (aucun serveur externe)
STUN_SERVER=

# --- Base de donnees (MariaDB integree) ----------------------------------------
MARIADB_ENABLED=true
DB_NAME=kmp_rtc
DB_USER=kmp_app
DB_PASSWORD=
CDR_DB_USER=asterisk_cdr
CDR_DB_PASSWORD=
MARIADB_INNODB_BUFFER_POOL=128M
MARIADB_MAX_CONNECTIONS=150

# --- Enregistrements (audio des appels et conferences, fichiers audio/video des applis) ---
RECORD_CALLS=true
RECORD_CONFERENCES=true
# wav (qualite, ~1 Mo/min) | wav49 (compresse, ~100 Ko/min) | gsm | ogg
RECORDING_FORMAT=wav
# Taille max d'un fichier audio/video envoye par une appli
RECORDINGS_MAX_UPLOAD_MB=500
# Suppression automatique apres N jours (0 = jamais)
RECORDINGS_RETENTION_DAYS=0

# --- API Ktor -----------------------------------------------------------------
# Secret de signature JWT (32 caracteres minimum, vide = genere)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# Compte admin cree au premier demarrage (laisser vide pour ne pas en creer)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret HMAC des webhooks entrants (vide = webhooks desactives)
WEBHOOK_SECRET=
LOG_LEVEL=INFO
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=35 -XX:+ExitOnOutOfMemoryError -XX:+UseStringDeduplication -Xss512k
